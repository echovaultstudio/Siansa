# Copy to .env next to docker-compose.yml and fill in. Never commit .env.

# The domain for the website, privacy page and F-Droid repo (an A/AAAA record pointing at this server).
DOMAIN=siansa.app
# The demo Navidrome for Google's reviewers and testers, on its own name (also pointing at this server).
DEMO_DOMAIN=demo.siansa.app
# How HTTPS works: "cloudflare" when the DNS records are proxied by Cloudflare (orange cloud), with a Cloudflare
# Origin Certificate in certs/ (see README); "auto" when they point straight here (Let's Encrypt).
TLS_MODE=cloudflare
# Let's Encrypt sends certificate expiry warnings here (used with TLS_MODE=auto).
ACME_EMAIL=you@example.com

# Where things live on the server.
FDROID_DIR=/srv/fdroid
SITE_DIR=/srv/siansa-site
SIGNUPS_DIR=/srv/siansa-signups
DEMO_MUSIC_DIR=/srv/siansa-demo/music
DEMO_DATA_DIR=/srv/siansa-demo/data

# The demo Navidrome's admin (user "admin"), made at first start. A long random one: openssl rand -base64 24
DEMO_ADMIN_PASSWORD=

# Beta sign-ups: you get an email with Approve / Deny links for each one; approved testers are emailed their login.
# Signs the links. Made by scripts/setup.sh if empty; keep it secret (openssl rand -hex 32).
SIGNUP_SECRET=
# How many beta testers at once (Google Play and F-Droid together). More sign-ups wait and are approved
# automatically, oldest first, when a place frees up. Google needs at least 12 for a new personal Play account.
BETA_LIMIT=12
# Where the approval emails go (your own address).
NOTIFY_TO=help@siansa.app
# Problem reports from the app (Settings > Report a problem). A fine-grained GitHub token for the beta testers repo
# only, with "Issues: Read and write" and nothing else. Leave empty and reports are kept but no issue is opened.
GITHUB_TOKEN=
# A private repository that keeps a copy of each report's log (so it can be read next to its issue). Give the
# token above "Contents: Read and write" on this repository too. Leave empty to keep logs on this server only.
REPORTS_REPO=
# A mailbox on your mail server that this server sends through (STARTTLS on port 587).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Siansa <no-reply@siansa.app>
