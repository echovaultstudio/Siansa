# Copy to .env next to docker-compose.yml and fill in. Never commit .env.

# The domain for the website, privacy page and F-Droid repo (an A/AAAA record pointing at this server).
DOMAIN=siansa.app
# The demo Navidrome for Google's reviewers and testers, on its own name (also pointing at this server).
DEMO_DOMAIN=demo.siansa.app
# How HTTPS works: "cloudflare" when the DNS records are proxied by Cloudflare (orange cloud), with a Cloudflare
# Origin Certificate in certs/ (see README); "auto" when they point straight here (Let's Encrypt).
TLS_MODE=cloudflare
# Let's Encrypt sends certificate expiry warnings here (used with TLS_MODE=auto).
ACME_EMAIL=you@example.com

# Where things live on the server.
FDROID_DIR=/srv/fdroid
SITE_DIR=/srv/siansa-site
DEMO_MUSIC_DIR=/srv/siansa-demo/music
DEMO_DATA_DIR=/srv/siansa-demo/data

# The demo Navidrome's admin (user "admin"), made at first start. A long random one: openssl rand -base64 24
DEMO_ADMIN_PASSWORD=
