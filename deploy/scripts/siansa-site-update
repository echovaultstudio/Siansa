#!/usr/bin/env python3
"""Updates the website pages and the beta emails from a tar.gz on stdin (issue #410). Run by siansa-ci for CI's key.

The archive holds `site/<file>` and `emails/<file>`: plain files only, no folders, links or odd names, up to 20 MB.
Nothing is changed unless every file passes. Files not in the archive are removed from those two folders, so
a page deleted in the repo is deleted here. Pages get {{DOMAIN}} filled in, as setup.sh does.
"""
import io, os, re, sys, tarfile

SITE_DIR = os.environ.get("SITE_DIR", "/srv/siansa-site")
EMAILS_DIR = os.environ.get("EMAILS_DIR", "/srv/siansa-emails")
DOMAIN_FILE = os.environ.get("DOMAIN_FILE", "/etc/siansa/domain")
MAX_BYTES = 20 * 1024 * 1024
NAME = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$")
ALLOWED = {
    "site": {".html", ".css", ".js", ".png", ".ico", ".svg", ".jpg", ".webp", ".txt"},
    "emails": {".txt", ".md"},
}


def fail(msg):
    print("rejected:", msg, file=sys.stderr)
    sys.exit(2)


def read(stream):
    data = stream.read(MAX_BYTES + 1)
    if len(data) > MAX_BYTES:
        fail("too big")
    return data


def collect(data):
    files = {"site": {}, "emails": {}}
    total = 0
    try:
        tar = tarfile.open(fileobj=io.BytesIO(data), mode="r:gz")
        members = tar.getmembers()
    except (tarfile.TarError, OSError, EOFError):
        fail("not a tar.gz")
    for m in members:
        if m.isdir():
            if m.name.strip("./") in ("site", "emails", ""):
                continue
            fail("folder " + m.name)
        if not m.isreg():
            fail("not a plain file: " + m.name)
        parts = m.name.lstrip("./").split("/")
        if len(parts) != 2 or parts[0] not in files or not NAME.match(parts[1]):
            fail("name " + m.name)
        if os.path.splitext(parts[1])[1].lower() not in ALLOWED[parts[0]]:
            fail("type " + m.name)
        total += m.size
        if total > MAX_BYTES:
            fail("too big")
        files[parts[0]][parts[1]] = tar.extractfile(m).read()
    if not files["site"].get("index.html"):
        fail("site/index.html is missing")
    return files


def install(folder, files, domain=None):
    os.makedirs(folder, exist_ok=True)
    for name, content in files.items():
        if domain and name.endswith(".html"):
            content = content.replace(b"{{DOMAIN}}", domain.encode())
        tmp = os.path.join(folder, "." + name + ".new")
        with open(tmp, "wb") as f:
            f.write(content)
        os.chmod(tmp, 0o644)
        os.replace(tmp, os.path.join(folder, name))
    for name in os.listdir(folder):
        path = os.path.join(folder, name)
        if name not in files and os.path.isfile(path) and not os.path.islink(path):
            os.remove(path)


def main():
    files = collect(read(sys.stdin.buffer))
    domain = open(DOMAIN_FILE).read().strip() if os.path.exists(DOMAIN_FILE) else ""
    if not domain:
        fail("the domain isn't set (run enable-site-deploy.sh)")
    install(SITE_DIR, files["site"], domain)
    install(EMAILS_DIR, files["emails"])
    print(f"site: {len(files['site'])} files, emails: {len(files['emails'])} files")


if __name__ == "__main__":
    main()
