#!/bin/sh
# Adds one Siansa APK to the F-Droid repo (issue #410). Run by CI over SSH as the siansa-deploy user, through a
# forced command in its authorized_keys: the APK arrives on stdin, nothing else can be run with that key.
#   ssh siansa-deploy@server < siansa-0.28.0beta.apk
set -eu

FDROID_DIR="${FDROID_DIR:-/srv/fdroid}"
MAX_BYTES=$((200 * 1024 * 1024))
LOCK="$FDROID_DIR/.publish.lock"

cd "$FDROID_DIR"
exec 9>"$LOCK"
flock -w 600 9

tmp=$(mktemp "$FDROID_DIR/tmp/incoming.XXXXXX")
trap 'rm -f "$tmp"' EXIT
head -c $((MAX_BYTES + 1)) > "$tmp"

size=$(stat -c %s "$tmp")
if [ "$size" -gt "$MAX_BYTES" ] || [ "$size" -lt 1024 ]; then
	echo "rejected: size $size" >&2
	exit 2
fi
# An APK is a zip with a manifest and a signature; anything else is turned away.
if ! unzip -l "$tmp" AndroidManifest.xml >/dev/null 2>&1; then
	echo "rejected: not an APK" >&2
	exit 2
fi
id=$(aapt dump badging "$tmp" 2>/dev/null | sed -n "s/^package: name='\([^']*\)'.*versionCode='\([0-9]*\)'.*versionName='\([^']*\)'.*/\1 \2 \3/p")
set -- $id
if [ "${1:-}" != "app.siansa" ]; then
	echo "rejected: package ${1:-unknown}" >&2
	exit 2
fi
if ! apksigner verify "$tmp" >/dev/null 2>&1; then
	echo "rejected: signature" >&2
	exit 2
fi

dest="repo/app.siansa_$2.apk"
if [ -e "$dest" ]; then
	echo "already published: $3 ($2)"
	exit 0
fi
mv "$tmp" "$dest"
chmod 644 "$dest"
fdroid update --use-date-from-apk >/dev/null
echo "published: $3 ($2)"
