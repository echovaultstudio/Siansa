#!/bin/sh
# Show the beta sign-ups (newest address wins when someone signed up twice).
#   sudo sh scripts/signups            a table
#   sudo sh scripts/signups play       just the APPROVED Google Play emails, comma separated, to paste into Play Console
#   sudo sh scripts/signups fdroid     just the approved F-Droid emails
#   sudo sh scripts/signups csv        everything as CSV
#   sudo sh scripts/signups revoke EMAIL   take away a tester's place and link; the next one waiting is approved
#   (resend the approval emails: sudo docker compose exec signup python -I /app/server.py resend)
set -eu
FILE="${SIGNUPS_FILE:-/srv/siansa-signups/signups.jsonl}"
HERE=$(cd "$(dirname "$0")/.." && pwd)
if [ "${1:-}" = revoke ]; then
	# Inside the container, so a freed place can email the next person on the waiting list.
	exec docker compose --project-directory "$HERE" exec -T signup python -I /app/server.py revoke "${2:?Give the tester's email}"
fi
[ -s "$FILE" ] || { echo "No sign-ups yet."; exit 0; }
python3 -I - "$FILE" "${1:-table}" <<'PY'
import csv, json, sys
import os
decisions = {}
dpath = os.path.join(os.path.dirname(sys.argv[1]), "decisions.jsonl")
if os.path.exists(dpath):
    for line in open(dpath):
        if line.strip():
            d = json.loads(line)
            decisions[d["id"]] = d["status"]
rows = {}
for line in open(sys.argv[1]):
    if line.strip():
        r = json.loads(line)
        r["status"] = decisions.get(r.get("id"), "pending")
        rows[r["email"]] = r
rows = sorted(rows.values(), key=lambda r: r["time"])
mode = sys.argv[2]
if mode in ("play", "fdroid"):
    print(", ".join(r["email"] for r in rows if r["route"] == mode and r["status"] == "approved"))
elif mode == "csv":
    w = csv.writer(sys.stdout)
    w.writerow(["time", "email", "route", "server", "device", "status"])
    for r in rows:
        w.writerow([r["time"], r["email"], r["route"], r["server"], r["device"], r["status"]])
else:
    for r in rows:
        print(f'{r["time"]}  {r["email"]:<34} {r["route"]:<7} {r["server"]:<10} {r["status"]:<9} {r["device"]}')
    print(f"{len(rows)} people")
PY
