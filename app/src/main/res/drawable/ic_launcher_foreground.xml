    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Soft glow behind the bars so they lift off the dark background -->
    <path android:pathData="M54,52m-34,0a34,34 0 1,1 68,0a34,34 0 1,1 -68,0">
        <aapt:attr name="android:fillColor">
            <gradient android:type="radial" android:centerX="54" android:centerY="52" android:gradientRadius="34">
                <item android:offset="0" android:color="#667C5CFF" />
                <item android:offset="0.55" android:color="#227C5CFF" />
                <item android:offset="1" android:color="#007C5CFF" />
            </gradient>
        </aapt:attr>
    </path>
    <path android:pathData="M31,59a3,3 0 0,1 6,0v8a3,3 0 0,1 -6,0z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="linear" android:startX="34" android:startY="56" android:endX="34" android:endY="70"
                android:startColor="#E4DCFF" android:endColor="#9A80F5" />
        </aapt:attr>
    </path>
    <path android:pathData="M41,47a3,3 0 0,1 6,0v20a3,3 0 0,1 -6,0z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="linear" android:startX="44" android:startY="44" android:endX="44" android:endY="70"
                android:startColor="#EDE6FF" android:endColor="#A891FF" />
        </aapt:attr>
    </path>
    <path android:pathData="M51,37a3,3 0 0,1 6,0v30a3,3 0 0,1 -6,0z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="linear" android:startX="54" android:startY="34" android:endX="54" android:endY="70"
